<section class="trash-header flexcol">
    <nav class="doc-type-grid" aria-role="{{localize 'SHEETS.FormNavLabel'}}">
        {{#each store}}
        <button type="button" class="doc-type-btn {{ifThen active " active" "" }}" data-action="selectDocType"
            data-doc-type="{{name}}">
            <i class="{{icon}}" inert></i>
            <span class="btn-label">{{label}}</span>
        </button>
        {{/each}}
    </nav>
    <search class="trash-search" aria-label="{{localize 'DND5E.CompendiumBrowser.Filters.SearchResults'}}">
        <input type="search" placeholder="{{localize 'DND5E.CompendiumBrowser.Filters.SearchResults'}}">
    </search>
    <div class="tools-section">
        <div class="sort-btn-section">
            <a class="sort-btn icon" data-action="toggleSort" data-tooltip="Toggle Sort Direction">
                {{#if isSortAsc}}
                <i class="fa-solid fa-arrow-down-wide-short"></i>
                {{else}}
                <i class="fa-solid fa-arrow-up-wide-short"></i>
                {{/if}}
            </a>
        </div>
        <div class="slider-section">
            <label class="flex0">Grid Size</label>
            <range-picker class="size-range-picker" name="size" min="0" value="{{gridSize}}" max="100"
                step="1"></range-picker>
        </div>
    </div>
</section>