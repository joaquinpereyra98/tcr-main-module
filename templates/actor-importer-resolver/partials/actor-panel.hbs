<div class="tcr-document-panel {{class}}">
    <h3>{{title}}</h3>
    <div class="tcr-document-summary">
        <div class="tcr-document-image">
            <img src="{{doc.img}}" alt="{{doc.name}}">
        </div>
        <div class="tcr-document-header">
            <div class="tcr-document-name" data-tooltip="{{doc.name}}">{{doc.name}}</div>
            <div class="tcr-document-meta">{{localize (lookup config.Actor.typeLabels actor.type)}}</div>
            <div class="tcr-document-meta">{{doc.items.size}} embedded item(s)</div>
            <div class="tcr-document-uuid" data-tooltip="{{doc.uuid}}">{{doc.uuid}}</div>
        </div>
    </div>
    <div class="tcr-embedded-scroll">
        {{#each embedded}}
        <section class="tcr-group">
            <h3 class="tcr-collection-title">{{label}}</h3>
    
            {{#each types}}
            <div class="tcr-type-block">
                {{#if label}}
                <h4 class="tcr-type-title">
                    <span>{{label}}</span>
                    <span class="tcr-badge">{{items.length}}</span>
                </h4>
                {{/if}}
    
                <div class="tcr-embedded-links">
                    {{#each items}}
                    {{{this}}}
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </section>
        {{else}}
        <section class="tcr-empty">
            <i class="fa-solid fa-folder-open"></i>
            <span>No embedded items found.</span>
        </section>
        {{/each}}
    </div>
</div>