<div class="tcr-embedded-section tcr-pages-section">
    {{#if embedded.length}}
    <section class="tcr-group">
        <h3 class="tcr-collection-title">
            <span>{{localize "DOCUMENT.JournalEntryPages"}}</span>
            <span class="tcr-badge">{{embedded.length}}</span>
        </h3>

        <div class="tcr-type-block">
            <div class="tcr-embedded-list-grid pages">
                {{#each embedded as |page|}}
                <div class="tcr-page-item" data-uuid="{{page.uuid}}" data-action="openPage"
                    data-tooltip="{{page.name}}">
                    <div class="tcr-page-details">
                        <i class="tcr-item-icon {{page.icon}}"></i>
                        <span class="tcr-item-name"> {{page.name}} </span>
                        <span class="tcr-item-type"> {{ifThen page.typeLabel page.type}} </span>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </section>
    {{else}}
    <section class="tcr-empty">
        <i class="fa-solid fa-book-open"></i>
        <span>No pages found...</span>
    </section>
    {{/if}}
</div>